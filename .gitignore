# Materialised reference textures. Rebuild with:
#   bin/mc-art evidence --source <jar> --name <asset>
# Content-addressed, so the same jar reproduces the same blob paths.
references/

# Minecraft's own textures, pulled from a game jar by examples/example_family
# and examples/**/refs. They are Mojang's art and must not be redistributed.
examples/**/refs/
examples/**/out/
examples/**/textures/

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Local scratch. Ignored is not enough on its own: anything that copies this
# directory wholesale (the DSH panel vendors bundled skills that way) carries
# ignored files too. `__pycache__/*.pyc` embeds the absolute path it was
# compiled from and pytest scratch carries absolute paths in its JSON, so keep
# the temp root OUTSIDE the tree and run `git clean -Xfd` before packaging.
.pytest-tmp/
.pytest-of-*/
